# TruthLens AI - environment template.
# Copy to `backend/.env` (git-ignored) and fill in real values. Never commit
# backend/.env. backend/config.py auto-loads it at import time; real process
# environment variables always take precedence over values in this file.

# --- Groq (REQUIRED for all analysis: news / reviews / general) -------------
# Create a key at https://console.groq.com/keys  (keys look like: gsk_...)
GROQ_API_KEY=<gsk_your_api_key_here>
# Optional overrides (defaults shown):
#GROQ_BASE_URL=https://api.groq.com/openai/v1   (code appends /chat/completions)
GROQ_MODEL=openai/gpt-oss-120b
#GROQ_TIMEOUT_SECONDS=30
#GROQ_MAX_TOKENS=800

# --- Backend API auth (X-API-Key on sensitive endpoints) --------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRUTHLENS_API_KEY=<your_api_key_here>

# --- Optional extras --------------------------------------------------------
#TRUTHLENS_CORS_ORIGINS=http://localhost:5173,https://truthlens.ai
#TRUTHLENS_DATABASE_URL=sqlite:///./backend/data/truthlens.db
